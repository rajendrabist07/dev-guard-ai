# Numeric ID from the GitHub App settings page.
GITHUB_APP_ID=

# GitHub App private key contents, with newlines escaped as \n for Vercel/local env files.
GITHUB_APP_PRIVATE_KEY=

# Random secret configured in the GitHub App webhook settings.
GITHUB_WEBHOOK_SECRET=

# Public GitHub App slug or full install URL, used for the dashboard/nav install link.
GITHUB_APP_SLUG=
NEXT_PUBLIC_GITHUB_APP_SLUG=
GITHUB_APP_INSTALL_URL=
NEXT_PUBLIC_GITHUB_APP_INSTALL_URL=

# AI Models (Groq with Gemini Fallback)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase project URL from Project Settings > API.
SUPABASE_URL=

# Supabase anon public key, used only for read-only browser-safe calls.
SUPABASE_ANON_KEY=

# Supabase service role key, used server-side only for webhook writes.
SUPABASE_SERVICE_KEY=

# Optional GitHub personal token for local smoke tests before app installation auth is configured.
GITHUB_TOKEN=
