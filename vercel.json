{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/watchdog",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/retention",
      "schedule": "0 2 * * *"
    }
  ]
}
